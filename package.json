{
  "name": "dsh-auto-retry",
  "version": "0.1.0",
  "description": "Auto-retry model requests whose error message matches your patterns, with a 5s / 30s / 60s backoff.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Dat LQ.",
    "url": "https://github.com/dat-lequoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dat-lequoc/dsh-auto-retry.git"
  },
  "bugs": {
    "url": "https://github.com/dat-lequoc/dsh-auto-retry/issues"
  },
  "homepage": "https://github.com/dat-lequoc/dsh-auto-retry#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "retry",
    "backoff"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
